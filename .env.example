SINERGY_RELAYER_ML_DSA_87_SECRET_KEY_FILE=/secure/path/relayer.ml_dsa_87.key
SINERGY_RELAYER_SLH_DSA_PUBLIC_KEY_FILE=/secure/path/relayer.slh_dsa_shake_256s.pub
SINERGY_RELAYER_SLH_DSA_SECRET_KEY_FILE=/secure/path/relayer.slh_dsa_shake_256s.key

