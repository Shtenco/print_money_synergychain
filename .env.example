SYNERGY_BACKEND_RPC=http://127.0.0.1:9546

# Base
BASE_RPC_URL=https://YOUR_BASE_RPC
BASE_SINERGY_MESSENGER=0xYOUR_BASE_MESSENGER
SINERGY_BASE_MESSENGER=0xYOUR_SINERGY_MESSENGER

# Fresh dedicated relayer keys only
